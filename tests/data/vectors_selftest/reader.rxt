# hand-written; exercises every field of the .rxt format
dialect: ecmascript
unicode: 17.0

pattern: a(b|c)*d
flags:
subject: abcd
expect: 0-4 2-3

pattern: [a-z
flags:
expect: error syntax

pattern: \u{1F41F}
flags: u
subject: \u{1F41F}
expect: 0-4

pattern: (a|b)\1
flags:
subject: xaay
engines: backtrack
limits: max_steps=1000
expect: 1-3 1-2

# `options:` names an option directly, for a dialect with no flag alphabet to
# spell it in. It combines with `flags:` rather than replacing it, and the
# two may be written in either order.
pattern: a
flags: i
options: dotall multiline
subject: a
expect: 0-1

pattern: b
options: caseless
flags: s
subject: b
expect: 0-1

# `groups:` states each group's TEXT rather than its span, for vim, whose
# `matchlist()` answers in strings and which has no positional API for a
# submatch at all. `-` is a group that did not participate or matched empty,
# because vim gives '' for both.
pattern: (a)(b)?(c)
flags:
subject: ac
expect: 0-2
groups: a - c

# A space and a lone `-` have to be escaped, or the field could not be told
# from the separator and from the sentinel.
pattern: x( )(-)
flags:
subject: x -
expect: 0-3
groups: \x20 \x2D

# `expect: refused` says only that compiling must fail, which is all a
# reference that throws one exception for every bad pattern has said.
pattern: [a-z
flags:
expect: refused
