# Perl's full case folding, with perl v5.44.0 as the oracle.
# Written by tools/corpus/make_fold_vectors.py.
#
# Every code point with a full fold - all 104 `F` lines of
# CaseFolding.txt, folding to 73 distinct sequences - as a literal,
# as a character class member, and inside a negated class, against
# its fold, its fold uppercased and itself. Then the shapes that
# bound the rule: a range, a shorthand, a POSIX class, a property,
# `/aa`, and the reverse direction.
#
# `re_tests` has no case for a class member folding fully, so this
# library answered every one of them wrongly while the imported
# corpus read 2,592 of 2,592. documentation/dialects.md section 5.8
# states the rule; this is what holds it.
dialect: perl
unicode: 17.0

pattern: ^(?:\u00DF)$
flags: i
subject: ss
