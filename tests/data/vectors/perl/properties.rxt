# Property names with more than one reading, with perl v5.44.0 as the oracle.
# Written by tools/corpus/make_property_vectors.py.
#
# Every row's subject is a code point on which two readings of the
# same name **disagree** - drawn from their symmetric difference,
# taken from perl's own prop_invlist. A row here fails the moment a
# resolver picks a different reading than perl does.
#
# This is the class of row the corpus did not have. `\p{Greek}`
# resolved to Script here and to Script_Extensions in both
# references, and 75,919 vectors passed anyway, because a Greek
# letter is in both sets and nothing asked about U+0374.
#
# 347 names with more than one reading, 987 discriminating code
# points, 5726 rows.
dialect: perl
unicode: 17.0

