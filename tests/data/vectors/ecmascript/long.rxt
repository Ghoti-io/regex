# generated by tools/oracle/make_long_vectors.py
# oracle: node v24.21.0, Unicode 17.0
# Long subjects. Every other vector file in this directory is tens of
# bytes, which is the length at which a scanning bug does not show: an
# off-by-one in a restart, a counter that only overflows after a million
# steps, a memo sized from the wrong length. `repeat:` builds the subject
# so that the record stays readable.
dialect: ecmascript
unicode: 17.0

# 64 KB, every engine
pattern: ^a+$
flags: u
subject: a
repeat: 65536
engines: pike backtrack bitstate
expect: 0-$

# 1 MB, the simplest scan
pattern: ^a+$
flags: u
subject: a
repeat: 1048576
engines: pike
expect: 0-$

# 64 KB through a class
pattern: ^[a-z]+$
flags: u
subject: abc
repeat: 21845
engines: pike backtrack bitstate
expect: 0-$

# 1 MB through a class
pattern: ^[a-z]+$
flags: u
subject: abc
repeat: 349525
engines: pike
expect: 0-$

# 64 KB of a repeated group
pattern: ^(?:ab)+$
flags: u
subject: ab
repeat: 32768
engines: pike backtrack bitstate
expect: 0-$

# 512 KB of a repeated group
pattern: ^(?:ab)+$
flags: u
subject: ab
repeat: 262144
engines: pike
expect: 0-$

# 200 KB that must not match
pattern: ^a+$
flags: u
subject: ab
repeat: 100000
engines: pike
expect: nomatch

# 64 KB folded
pattern: ^[a-z]+$
flags: iu
subject: AbC
repeat: 21845
engines: pike backtrack bitstate
expect: 0-$

# 300 KB folded
pattern: ^[a-z]+$
flags: iu
subject: AbC
repeat: 100000
engines: pike
expect: 0-$

# 512 KB of two-byte characters
pattern: ^\p{L}+$
flags: u
subject: \u{e9}
repeat: 262144
engines: pike
expect: 0-$

# 512 KB of three-byte characters
pattern: ^\p{L}+$
flags: u
subject: \u{6f22}
repeat: 174762
engines: pike
expect: 0-$

# 512 KB of astral letters
pattern: ^\p{L}+$
flags: u
subject: \u{10400}
repeat: 131072
engines: pike
expect: 0-$

# 512 KB of astral non-letters
pattern: ^\p{L}+$
flags: u
subject: \u{1f1e6}
repeat: 131072
engines: pike
expect: nomatch

# 200 KB unanchored with no match
pattern: [0-9]+
flags: u
subject: ab
repeat: 100000
engines: pike backtrack bitstate
expect: nomatch

# 300 KB with structure
pattern: ^(?:[a-z]+,)+$
flags: u
subject: ab,
repeat: 100000
