# Build output
build

# Debug artifacts (GDB scripts, captured stderr, sanity/trace dumps)
*.gdb
*.txt
# ...but not the corpora, which are inputs rather than output. `*.txt` had
# quietly kept tools/limits/real_world.txt - half of what WP-14 measures the
# limit defaults against - out of every clone but this one, so `make
# check-limits` elsewhere would have produced a different table from the one
# documentation/dialects.md section 7 publishes.
!tools/limits/*.txt

# IDE / CTest run output (not used by project Makefile)
Testing

# Third-party / reference source trees (not tracked by name)
third_party

# Documentation generated by Doxygen
docs

# Example output files
example.output.*

# Task documents
tasks

# Test output (e.g. PNGs written by encode tests for verification)
tests/out

# Stray output under test data (use tests/out instead)
tests/data/out


# Pycache files (for generated test fixtures, in any directory)
**/__pycache__
